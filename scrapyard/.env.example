# Copy to .env and edit before running `docker compose up`.
# Use URL-safe characters in POSTGRES_PASSWORD (letters and digits) - it is embedded in a connection URL.

POSTGRES_USER=scrapyard
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=scrapyard

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Created on first start only, if no admin exists yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# true = load a few DEMO- records and a demo worker (worker1 / worker12345) into an empty database
SEED_DEMO_DATA=true
